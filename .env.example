# Server
PORT=5000
NODE_ENV=development

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pryntis

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=24h

# CORS (comma-separated origins)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage (local or s3)
STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=pryntis-media

# Apache Superset (optional)
# SUPERSET_URL=http://localhost:8088
# SUPERSET_GUEST_TOKEN_SECRET=your-secret
# SUPERSET_DASHBOARD_ID=1

# Email (future - not yet implemented)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=app-password

# Two-Factor Auth (future - not yet implemented)
# TWO_FACTOR_ENABLED=true
