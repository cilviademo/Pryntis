{
  "name": "pryntis-panel",
  "version": "1.0.0",
  "description": "Web-based administrative platform for music production operations",
  "private": true,
  "scripts": {
    "server": "node server/server.js",
    "server:dev": "nodemon server/server.js",
    "client": "npm start --prefix client",
    "client:install": "npm install --prefix client",
    "install:all": "npm install && npm install --prefix client",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "db:schema": "psql $DATABASE_URL -f database/schema.sql",
    "db:seed": "node server/seeds/run.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7"
  }
}
