{
  "name": "pryntis-panel",
  "version": "1.0.0",
  "description": "Web-based administrative platform for music production operations",
  "private": true,
  "scripts": {
    "server": "node server/server.js",
    "server:dev": "nodemon server/server.js",
    "client": "npm run dev --prefix client",
    "client:install": "npm install --prefix client",
    "install:all": "npm install && npm install --prefix client",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "dev:all": "docker compose up -d && sleep 3 && concurrently \"npm run server:dev\" \"npm run client\"",
    "db:schema": "psql $DATABASE_URL -f database/schema.sql",
    "db:seed": "node server/seeds/run.js",
    "db:reset": "psql $DATABASE_URL -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run db:schema && npm run db:seed",
    "reset": "docker compose down -v && docker compose up -d && sleep 4 && npm run db:seed",
    "test": "jest --forceExit --detectOpenHandles",
    "test:smoke": "jest --forceExit --detectOpenHandles --verbose",
    "build:prod": "cd client && npx vite build",
    "preflight": "node scripts/preflight.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}
